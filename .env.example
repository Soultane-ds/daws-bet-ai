# --- Server ---
PORT=3000
NODE_ENV=development            # set to production when deploying
JWT_SECRET=                     # REQUIRED in production: long random string (openssl rand -hex 32)
DATA_DIR=./data

# --- Football data / odds provider (server-side only, never sent to the browser) ---
FOOTBALL_PROVIDER=api-football  # api-football | none
API_FOOTBALL_KEY=               # your own licensed key from api-football.com
API_DAILY_LIMIT=100             # hard cap on provider requests per day (free plan = 100)

# --- Optional Google login ---
GOOGLE_CLIENT_ID=

# --- First admin account (created on boot if no admin exists) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

JOBS_ENABLED=1                  # background sync / analysis / settlement
